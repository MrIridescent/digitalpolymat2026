{
  "name": "digital-polymath-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve out",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "analyze": "cross-env ANALYZE=true next build",
    "generate:assets": "node scripts/generate-brand-assets.mjs",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate:brand": "npm run generate:favicon && npm run generate:assets",
    "generate:resume": "node scripts/generate-resume.mjs",
    "blog:setup": "node scripts/contentful-publish.mjs --setup",
    "blog:publish": "node scripts/contentful-publish.mjs",
    "blog:validate": "node scripts/contentful-publish.mjs --dry-run",
    "email:test": "node scripts/send-test-email.mjs",
    "seo:indexnow": "node scripts/seo-indexnow.mjs"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "clsx": "^2.1.0",
    "critters": "^0.0.25",
    "framer-motion": "^11.0.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.400.0",
    "next": "^15.4.2",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  }
}
