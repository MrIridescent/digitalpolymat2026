# =============================================================================
# mriridescent.africa — environment variables
# =============================================================================
#
# Local setup:
#   cp .env.example .env.local
#   Fill in the blank secrets. .env.local is gitignored.
#
# Netlify:
#   Site configuration → Environment variables.
#   Add the same names. Build-time values are available to `npm run build`;
#   function values (RESEND_*) are available to netlify/functions.
#
# Never prefix a secret with NEXT_PUBLIC_. Those values are shipped to every
# browser. Only NEXT_PUBLIC_SITE_URL belongs in the public bundle.

# =============================================================================
# SITE
# =============================================================================

NEXT_PUBLIC_SITE_URL=https://mriridescent.africa

# =============================================================================
# SEARCH CONSOLE VERIFICATION (optional, build-time)
# =============================================================================
# Paste the token only, not the full meta tag. Google Search Console →
# Add property → HTML tag. Bing Webmaster Tools → Verify → Meta tag.
# Both are optional; the site verifies fine by DNS or file upload instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow (Bing, Yandex, Seznam, Naver, Yep). The key is public by design and
# must match both public/<key>.txt and scripts/seo-indexnow.mjs. Rotate all
# three together if you ever change it.
INDEXNOW_KEY=9f4c2a7d8e1b6c3f5a0d9e7b2c4f8a16

# =============================================================================
# CONTACT FORM — NETLIFY FUNCTION + RESEND
# =============================================================================

# Required. Create a key at https://resend.com/api-keys and paste it here.
# This is the only secret the contact form needs.
RESEND_API_KEY=

# Every enquiry is delivered to this inbox. The function also defaults to this
# address if the variable is missing.
CONTACT_TO_EMAIL=me@mriridescent.africa

# The sender must be on a domain verified in Resend. The default sender uses
# hello.i2sltd.click; swap in website@mriridescent.africa once that domain is
# verified in Resend → Domains.
CONTACT_FROM_EMAIL="David Akpoviroro Oke <website@hello.i2sltd.click>"

# Optional. Set to "false" to stop sending the visitor an acknowledgement.
CONTACT_AUTO_REPLY=true

# Optional SMTP fallback, used only when RESEND_API_KEY is empty.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=website@hello.i2sltd.click
# SMTP_PASS=
# SMTP_FROM="David Akpoviroro Oke <website@hello.i2sltd.click>"

# =============================================================================
# JOURNAL — CONTENTFUL
# =============================================================================

# Read at build time by the static export. Server-side only.
# Without these, the journal uses the local essays in lib/blog-fallback.ts.
#
# Contentful has two read APIs. Pick one per build with CONTENTFUL_USE_PREVIEW:
#   Delivery API  cdn.contentful.com      published entries — production
#   Preview API   preview.contentful.com  drafts + published — local/staging
CONTENTFUL_SPACE_ID=

# Delivery API access token (published content).
CONTENTFUL_ACCESS_TOKEN=

# Preview API access token (drafts). Used only when CONTENTFUL_USE_PREVIEW=true.
# Never enable preview on the production Netlify site: drafts would be exported.
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
CONTENTFUL_USE_PREVIEW=false

CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_CONTENT_TYPE=blogPost
CONTENTFUL_LOCALE=en-US

# Write access for `npm run blog:publish`. Create a Content management token at
# Contentful → Settings → API keys → Content management tokens.
# SECRET: local .env.local or GitHub/Netlify secrets only.
CONTENTFUL_MANAGEMENT_TOKEN=

# Optional. Netlify build hook URL. After `npm run blog:publish`, the script
# calls this URL so Netlify rebuilds and the new post appears.
# Netlify → Site configuration → Build & deploy → Build hooks → Add build hook.
BLOG_REBUILD_WEBHOOK_URL=

# Optional fallback: dispatch a GitHub Actions workflow instead of a build hook.
# Needs a token with Actions: write access to the repository.
BLOG_REBUILD_TOKEN=
BLOG_REBUILD_REPO=mriridescent/digitalpolymat2026

# =============================================================================
# LOCAL TOOLING (optional)
# =============================================================================

# Bundle analysis: npm run analyze
# ANALYZE=true

# Résumé PDF generation. Set only if Chromium is not in Playwright's default
# cache location.
# PLAYWRIGHT_CHROMIUM_PATH=C:/path/to/chrome.exe
# RESUME_PREVIEW=false
